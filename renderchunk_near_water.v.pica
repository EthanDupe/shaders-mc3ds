; Upgraded Near-Water Chunk Shader (renderchunk_near_water.v.pica)
; Adds subtle Fresnel sheen at grazing camera angles while matching renderchunk_near_water.shbin registers

.alias aPosition v0
.alias aColor    v1
.alias aTexCoord v2
.alias bTexCoord v3

.fvec WORLDVIEWPROJ[4]
.fvec WORLDVIEW[4]
.fvec PROJ[4]
.fvec FOG_COLOR
.fvec FOG_CONTROL
.fvec RENDER_DISTANCE
.fvec VIEWPORT_DIMENSION
.fvec CURRENT_COLOR
.fvec CHUNK_ORIGIN_AND_SCALE
.fvec VIEW_POS
.fvec FAR_CHUNKS_DISTANCE

.constf w_consts(0.0, 1.0, 0.14, 0.08)

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.entry main
.proc main
    mov r0.xyz, aPosition.xyz
    mov r0.w, w_consts.y
    dp4 outpos.x, WORLDVIEWPROJ[0], r0
    dp4 outpos.y, WORLDVIEWPROJ[1], r0
    dp4 outpos.z, WORLDVIEWPROJ[2], r0
    dp4 outpos.w, WORLDVIEWPROJ[3], r0

    ; Compute approximate view-angle grazing factor from WORLDVIEW z/distance
    dp4 r2.x, WORLDVIEW[0], r0
    dp4 r2.y, WORLDVIEW[1], r0
    dp4 r2.z, WORLDVIEW[2], r0
    dp3 r3.x, r2, r2
    rsq r3.x, r3.x
    mul r2.y, r2.y, r3.x
    abs r2.y, r2.y
    add r2.x, w_consts.y, -r2.y
    max r2.x, w_consts.x, r2.x

    ; Subtle Fresnel boost to alpha and sky-tint brightness
    mul r1, aColor, CURRENT_COLOR
    mul r3.x, r2.x, w_consts.z
    add r1.w, r1.w, r3.x
    min r1.w, r1.w, w_consts.y

    mul r3.y, r2.x, w_consts.w
    add r1.xyz, r1.xyz, r3.yyy
    mov outclr, r1

    mov outtc0, aTexCoord
    mov outtc1, bTexCoord
    end
.end
